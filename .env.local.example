# â”€â”€â”€ Site â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
NEXT_PUBLIC_SITE_URL=https://team.co.zw

# â”€â”€â”€ Admin Authentication â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# The email address used to log into /admin
ADMIN_EMAIL=admin@team.co.zw

# scrypt hash of the admin password.
# Generate with:  node scripts/hash-password.mjs <yourpassword>
ADMIN_PASSWORD_HASH=

# Secret used to sign admin session tokens â€” must be 32+ random characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# Where admin notification emails are sent (defaults to ADMIN_EMAIL if unset)
ADMIN_NOTIFICATION_EMAIL=info@team.co.zw

# â”€â”€â”€ Email Delivery â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Set SUBMISSION_PROVIDER to activate a real email provider.
# Options: resend | sendgrid | mailchimp | (leave blank for local-fallback)
SUBMISSION_PROVIDER=resend

# Resend (https://resend.com) â€” rotate this key if it was ever committed or shared
RESEND_API_KEY=
# Verified sender domain/address in your Resend account
RESEND_FROM=TEAM Consulting <no-reply@team.co.zw>

# SendGrid (alternative to Resend)
SENDGRID_API_KEY=

# Mailchimp â€” used for newsletter subscriptions when SUBMISSION_PROVIDER=mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# â”€â”€â”€ Sanity CMS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
